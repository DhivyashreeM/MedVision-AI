# ==============================================================================
# MedVision AI — Environment Configuration Template
# Copy this file to .env and adjust variables as needed for local development.
# NEVER commit real credentials or production secrets to source control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="MedVision AI"
API_V1_STR="/api/v1"

# Server / API Configuration
HOST=0.0.0.0
PORT=8000
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:8501"]

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Storage & Paths
DATA_DIR="./data"
MODELS_DIR="./models"
OUTPUTS_DIR="./outputs"
CHECKPOINT_PATH="./models/checkpoints/baseline_densenet121.pth"

# Inference & Image Constraints
MAX_UPLOAD_SIZE_BYTES=10485760  # 10 MB limit
SUPPORTED_IMAGE_FORMATS=["image/jpeg","image/png","image/dicom","image/tiff"]

# Model Runtime Settings (Phase 4+ targets)
DEVICE=cpu
DEFAULT_BATCH_SIZE=16
CONFIDENCE_THRESHOLD=0.50
CALIBRATION_TEMPERATURE=1.0
