# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
.venv/
venv/
ENV/
env/

# Build artifacts & Egg Info
*.egg-info/
dist/
build/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Data directories (Strict medical data privacy: Never commit raw/processed medical data)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/metadata/*
!data/metadata/.gitkeep
!data/metadata/dataset_manifest.json
data/sample/*
!data/sample/.gitkeep

# Model weights and checkpoints
models/checkpoints/*
!models/checkpoints/.gitkeep
models/exported/*
!models/exported/.gitkeep

# Outputs and Artifacts
outputs/**/*
!outputs/**/
!outputs/**/.gitkeep

# Testing and Coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# IDE and OS Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
